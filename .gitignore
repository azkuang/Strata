docs/
.claude/

# Python / uv
.venv/
__pycache__/
*.pyc

# Model weights / HF cache (never commit large binaries)
models/
*.safetensors
*.gguf

# Third-party sources built locally (llama.cpp, etc.) — reference only, not vendored
third_party/

# Benchmark artifacts that may include large logs (keep the curated write-up only)
benchmarks/*.json
benchmarks/*.log
benchmarks/raw/*
# ...except M5's grid results: 9 small JSONL rows, cited by name in README.md
# and benchmarks/m5_report.md, so the write-up's numbers stay traceable.
!benchmarks/raw/m5_results.jsonl
